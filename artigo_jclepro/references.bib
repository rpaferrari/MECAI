@article{mapa2012uso,
  author    = {Mapa, Sílvia Maria Santana and Lima, Renato da Silva},
  title     = {Uso combinado de sistemas de informações geográficas para transportes e programação linear inteira mista em problemas de localização de instalações},
  journal   = {Gestão \& Produção},
  volume    = {19},
  number    = {1},
  pages     = {119--136},
  year      = {2012},
  issn      = {0104-530X},
  month     = {janeiro/março},
  url       = {http://dx.doi.org/10.1590/S0104-530X2012005000007},
  abstract  = {O objetivo do trabalho é avaliar a qualidade das soluções para o problema de localização-alocação de instalações geradas por um SIG-T (Sistema de Informação Geográfica para Transportes), obtidas após a utilização combinada das rotinas Localização de Facilidades e Problema do Transporte, quando comparadas com as soluções ótimas obtidas a partir de modelo matemático exato baseado em Programação Linear Inteira Mista (PLIM), desenvolvido externamente ao SIG. Os modelos foram aplicados a três simulações: a primeira propõe a abertura de fábricas e alocação de clientes no Estado de São Paulo; a segunda envolve um atacadista e um estudo de localização de centros de distribuição e alocação dos clientes varejistas; a terceira localiza creches em um contexto urbano, alocando a demanda. Os resultados mostraram que, quando se considera a capacidade das instalações, o modelo otimizante PLIM chegou a apresentar, em um dos cenários simulados, resultados até 37\% melhores do que o SIG, além de propor locais diferentes para abertura de novas instalações. Quando não se considera a capacidade, os resultados foram semelhantes, em termos de valor da função objetivo, mas diferentes quanto à localização das instalações. O artigo ainda apresenta a modelagem matemática utilizada para a formulação do problema e um breve referencial teórico sobre a utilização de SIGs em problemas de localização e alocação, concluindo pela superioridade do modelo PLIM na obtenção da solução ótima de custo.}
}

